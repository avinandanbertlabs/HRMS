    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "prettier": "^3.5.3",
    "prisma": "^6.10.1",
    "tailwindcss": "^4.1.8",
